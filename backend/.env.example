# Copy to .env and fill in your values

# MongoDB connection string (e.g. from MongoDB Atlas or local)
MONGODB_URI=mongodb://localhost:27017/ai-exam-assistant

# Secret for signing JWT tokens (use a long random string in production)
JWT_SECRET=your-super-secret-key-change-in-production

# Google Gemini API key (for AI question generation)
GEMINI_API_KEY=your-gemini-api-key
